{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/mv_final.json"
  },
  "transform": [
    {
      "filter": "isValid(datum.decade) && datum.decade >= 1870"
    },
    {
      "calculate": "indexof(['Disc Recording','Symphonion Disc'], datum.object_type) >= 0 ? 'Recordings' : indexof(['Sheet Music','Score','Song Book','Songbook'], datum.object_type) >= 0 ? 'Printed music' : 'Other objects'",
      "as": "kind"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "stack"
        }
      ],
      "groupby": [
        "decade"
      ],
      "sort": [
        {
          "field": "kind"
        },
        {
          "field": "object_type"
        }
      ]
    }
  ],
  "mark": {
    "type": "circle",
    "size": 150,
    "opacity": 0.95,
    "stroke": "#FAF7F0",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "title": "Decade",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "stack",
      "type": "quantitative",
      "title": "Items (one dot each)",
      "axis": {
        "tickMinStep": 5
      }
    },
    "color": {
      "field": "kind",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Recordings",
          "Printed music",
          "Other objects"
        ],
        "range": [
          "#7A2E3B",
          "#B8872B",
          "#1C2340"
        ]
      }
    },
    "tooltip": [
      {
        "field": "title",
        "title": "Item"
      },
      {
        "field": "year"
      }
    ],
    "opacity": {
      "condition": {
        "param": "kind_pick",
        "value": 1
      },
      "value": 0.22
    }
  },
  "config": {
    "axis": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "legend": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "kind_pick",
      "select": {
        "type": "point",
        "fields": [
          "kind"
        ]
      },
      "bind": "legend"
    }
  ]
}