{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/melbourne_suburbs.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.kind === 'sea'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#DCE6E8"
      }
    },
    {
      "data": {
        "url": "data/melbourne_suburbs.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.kind === 'suburb'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FAF7F0",
        "strokeWidth": 0.6
      },
      "encoding": {
        "fill": {
          "condition": {
            "test": "datum.properties.has_items",
            "value": "#D9C58F"
          },
          "value": "#EADFC3"
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Suburb"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/mv_locality_counts.json"
      },
      "transform": [
        {
          "filter": "datum.in_australia && datum.lng > 144.5 && datum.lng < 145.6 && datum.lat > -38.2 && datum.lat < -37.4"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#7A2E3B",
        "fillOpacity": 0.6,
        "stroke": "#FAF7F0",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "items",
          "type": "quantitative",
          "scale": {
            "range": [
              50,
              1500
            ]
          },
          "legend": {
            "title": "Items",
            "orient": "bottom-right",
            "values": [
              1,
              10,
              30
            ]
          }
        },
        "tooltip": [
          {
            "field": "locality",
            "title": "Place"
          },
          {
            "field": "items",
            "title": "Items"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/mv_locality_counts.json"
      },
      "transform": [
        {
          "filter": "datum.locality === 'Melbourne'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": 38,
        "font": "Spectral, Georgia, serif",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1C2340"
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "locality"
        }
      }
    },
    {
      "data": {
        "url": "data/mv_locality_counts.json"
      },
      "transform": [
        {
          "filter": "datum.locality === 'Carlton'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": -32,
        "font": "Spectral, Georgia, serif",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1C2340"
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "locality"
        }
      }
    },
    {
      "data": {
        "url": "data/mv_locality_counts.json"
      },
      "transform": [
        {
          "filter": "datum.locality === 'Kew'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "dy": 4,
        "font": "Spectral, Georgia, serif",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1C2340"
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "locality"
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "legend": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "view": {
      "stroke": null
    }
  }
}
