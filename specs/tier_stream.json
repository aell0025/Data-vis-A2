{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/discogs_final.json"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "count"
        }
      ],
      "groupby": [
        "decade",
        "collectible_tier"
      ]
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "title": "Decade"
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "stack": "center",
      "title": null,
      "axis": null
    },
    "color": {
      "field": "collectible_tier",
      "type": "nominal",
      "sort": [
        "none",
        "low",
        "mid",
        "high"
      ],
      "title": "Pressing tier",
      "scale": {
        "range": [
          "#C9BFA5",
          "#B8872B",
          "#7A2E3B",
          "#1C2340"
        ]
      }
    },
    "opacity": {
      "condition": {
        "param": "tier_pick",
        "value": 1
      },
      "value": 0.22
    }
  },
  "config": {
    "axis": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "legend": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    }
  },
  "params": [
    {
      "name": "tier_pick",
      "select": {
        "type": "point",
        "fields": [
          "collectible_tier"
        ]
      },
      "bind": "legend"
    }
  ]
}