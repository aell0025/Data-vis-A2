{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "data": {
    "url": "data/decade_shares.json"
  },
  "mark": {
    "type": "bar",
    "height": {
      "band": 0.8
    }
  },
  "encoding": {
    "y": {
      "field": "decade",
      "type": "ordinal",
      "sort": "ascending",
      "title": null,
      "axis": {
        "labelExpr": "datum.label + 's'",
        "labelPadding": 6
      }
    },
    "x": {
      "field": "signed",
      "type": "quantitative",
      "title": "\u2190 Museum objects (% of dated items)        Record releases (% of sample) \u2192",
      "axis": {
        "labelExpr": "abs(datum.value) + '%'",
        "tickMinStep": 5
      }
    },
    "color": {
      "field": "source",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Museum objects",
          "Record releases"
        ],
        "range": [
          "#1C2340",
          "#B8872B"
        ]
      },
      "legend": {
        "orient": "top"
      }
    },
    "tooltip": [
      {
        "field": "source"
      },
      {
        "field": "decade",
        "title": "Decade"
      },
      {
        "field": "count",
        "title": "Items"
      },
      {
        "field": "pct",
        "title": "Share (%)"
      }
    ]
  },
  "config": {
    "axis": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "legend": {
      "labelFont": "Spectral, Georgia, serif"
    },
    "view": {
      "stroke": null
    }
  }
}