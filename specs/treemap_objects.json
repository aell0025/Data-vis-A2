{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "height": 380,
  "padding": 0,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": [
    {
      "name": "tree",
      "url": "data/mv_treemap.json",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "size",
          "sort": {
            "field": "value"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.2,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Music",
        "Music & musical instruments",
        "Performers",
        "Performing arts - concerts",
        "Performing arts - ensembles",
        "Playback media - analogue"
      ],
      "range": [
        "#7A2E3B",
        "#B8872B",
        "#1C2340",
        "#A65A64",
        "#5E6A8F",
        "#9A8F73",
        "#C9A64B",
        "#3E5C55"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#EFE6D0"
          },
          "strokeWidth": {
            "value": 1.5
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "parent"
          },
          "tooltip": {
            "signal": "datum.name + ': ' + datum.size + ' items'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "font": {
            "value": "Spectral, Georgia, serif"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#FAF7F0"
          },
          "baseline": {
            "value": "top"
          },
          "lineHeight": {
            "value": 13
          }
        },
        "update": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 5"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0 - 9) >= length(datum.name) * 5.6 ? ((datum.y1 - datum.y0) > 22 ? datum.name : '') : (length(split(datum.name, ' ')) == 2 && (datum.y1 - datum.y0) > 40 && (datum.x1 - datum.x0) > 44 ? split(datum.name, ' ') : ((datum.x1 - datum.x0) > 62 && (datum.y1 - datum.y0) > 22 ? datum.name : ''))"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 9"
          },
          "ellipsis": {
            "value": "\u2026"
          }
        }
      }
    }
  ],
  "signals": [
    {
      "name": "width",
      "init": "containerSize()[0] > 0 ? containerSize()[0] : 520",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0] > 0 ? containerSize()[0] : 520"
        }
      ]
    }
  ]
}