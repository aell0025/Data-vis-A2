{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#DDD3BC",
        "stroke": "#EFE6D0",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Antarctica'"
        },
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/discogs_country_counts.json"
            },
            "key": "country",
            "fields": [
              "releases",
              "high_tier"
            ]
          }
        },
        {
          "calculate": "datum[measure]",
          "as": "shown"
        },
        {
          "filter": "isValid(datum.shown) && datum.shown > 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#EFE6D0",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "shown",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              "#E3C77A",
              "#B8872B",
              "#7A2E3B",
              "#1C2340"
            ]
          },
          "legend": {
            "title": "Releases shown"
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Country"
          },
          {
            "field": "releases",
            "title": "All releases"
          },
          {
            "field": "high_tier",
            "title": "Special pressings"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "legend": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    }
  },
  "params": [
    {
      "name": "measure",
      "value": "releases",
      "bind": {
        "input": "radio",
        "options": [
          "releases",
          "high_tier"
        ],
        "labels": [
          "All releases",
          "Special pressings only"
        ],
        "name": "Show: "
      }
    }
  ]
}