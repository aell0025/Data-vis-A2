{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "height": 400,
  "padding": 0,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "signals": [
    {
      "name": "width",
      "init": "containerSize()[0] > 0 ? containerSize()[0] : 640",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0] > 0 ? containerSize()[0] : 640"
        }
      ]
    },
    {
      "name": "hovered",
      "value": null,
      "on": [
        {
          "events": "@node:mouseover",
          "update": "datum.name"
        },
        {
          "events": "@node:mouseout",
          "update": "null"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "xs",
      "type": "linear",
      "domain": [
        46,
        500
      ],
      "range": [
        46,
        {
          "signal": "width - 140"
        }
      ]
    }
  ],
