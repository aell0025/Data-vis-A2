{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#DDD3BC",
        "stroke": "#EFE6D0",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/mv_overseas_links.json"
      },
      "mark": {
        "type": "rule",
        "stroke": "#7A2E3B",
        "opacity": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lng2"
        },
        "latitude2": {
          "field": "lat2"
        },
        "strokeWidth": {
          "field": "items",
          "type": "quantitative",
          "scale": {
            "range": [
              1.5,
              5
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/mv_overseas_links.json"
      },
      "mark": {
        "type": "circle",
        "fill": "#1C2340",
        "size": 60
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "locality"
          },
          {
            "field": "items",
            "title": "Items"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "locality": "Melbourne",
            "items": 35,
            "lat": -37.8136,
            "lng": 144.9631,
            "in_australia": true
          }
        ]
      },
      "mark": {
        "type": "circle",
        "fill": "#B8872B",
        "size": 140
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "legend": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    }
  }
}