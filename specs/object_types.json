{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/mv_final.json"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "count"
        }
      ],
      "groupby": [
        "object_type"
      ]
    },
    {
      "filter": "datum.count >= 2"
    }
  ],
  "encoding": {
    "y": {
      "field": "object_type",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "count",
      "type": "quantitative",
      "title": "Items held",
      "scale": {
        "domain": [
          0,
          56
        ]
      },
      "axis": {
        "tickMinStep": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#7A2E3B"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "object_type",
            "title": "Object type"
          },
          {
            "field": "count",
            "title": "Items held"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "font": "Spectral, Georgia, serif",
        "fontSize": 12,
        "color": "#2B2B28"
      },
      "encoding": {
        "text": {
          "field": "count",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "view": {
      "stroke": null
    }
  }
}