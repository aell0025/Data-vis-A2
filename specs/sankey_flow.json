      "transform": [
        {
          "type": "formula",
          "expr": "scale('xs', datum.sx - (datum.sc === 0 ? 14 : 96)) + (datum.sc === 0 ? 14 : 96)",
          "as": "sxp"
        },
        {
          "type": "formula",
          "expr": "scale('xs', datum.tx)",
          "as": "txp"
        },
        {
          "type": "linkpath",
          "orient": "horizontal",
          "shape": "diagonal",
          "sourceX": "sxp",
          "sourceY": "sy",
          "targetX": "txp",
          "targetY": "ty"
        }
      ]
    },
    {
      "name": "n0",
      "source": "nodes",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.col === 0"
        }
      ]
    },
    {
      "name": "n1",
      "source": "nodes",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.col === 1"
        }
      ]
    },
    {
      "name": "n2",
      "source": "nodes",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.col === 2"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "stroke": {
            "field": "color"
          },
          "strokeJoin": {
            "value": "round"
          },
          "strokeCap": {
            "value": "butt"
          },
          "strokeWidth": {
            "field": "w"
          },
          "strokeOpacity": [
            {
              "test": "hovered && datum.source !== hovered && datum.target !== hovered",
              "value": 0.1
            },
            {
              "value": 0.7
            }
          ],
          "tooltip": {
            "signal": "datum.source + ' \u2192 ' + datum.target + ': ' + datum.value + ' releases'"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "scale('xs', datum.x0)"
          },
          "width": {
            "signal": "datum.x1 - datum.x0"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "field": "color"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "n0"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "font": {
            "value": "Spectral, Georgia, serif"
          },
          "fontSize": {
            "value": 12
          },
          "baseline": {
            "value": "middle"
          },
          "align": {
            "value": "right"
          }
        },
        "update": {
          "x": {
            "signal": "scale('xs', datum.x0) - 6"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "text": {
            "field": "label"
          },
          "fill": {
            "value": "#2B2B28"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "n1"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "font": {
            "value": "Spectral, Georgia, serif"
          },
          "fontSize": {
            "value": 12
          },
          "baseline": {
            "value": "middle"
          },
          "align": {
            "value": "center"
          }
        },
        "update": {
          "x": {
            "signal": "scale('xs', datum.x0) + (datum.x1 - datum.x0) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "text": {
            "field": "label"
          },
          "fill": {
            "field": "tcolor"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "n2"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "font": {
            "value": "Spectral, Georgia, serif"
          },
          "fontSize": {
            "value": 12
          },
          "baseline": {
            "value": "middle"
          },
          "align": {
            "value": "left"
          }
        },
        "update": {
          "x": {
            "signal": "scale('xs', datum.x0) + (datum.x1 - datum.x0) + 6"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "text": {
            "field": "label"
          },
          "fill": {
            "value": "#2B2B28"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "node",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "scale('xs', datum.x0) - (datum.col === 0 ? 46 : 0)"
          },
          "x2": {
            "signal": "scale('xs', datum.x0) + (datum.x1 - datum.x0) + (datum.col === 2 ? 90 : 0)"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#000"
          },
          "fillOpacity": {
            "value": 0
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "datum.name + ': ' + datum.value + ' releases'"
          }
        }
      }
    }
  ]
}