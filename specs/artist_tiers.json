{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 640,
  "data": {
    "url": "data/discogs_final.json"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "artist",
        "collectible_tier"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "n",
          "as": "total"
        }
      ],
      "groupby": [
        "artist"
      ]
    },
    {
      "calculate": "datum.collectible_tier === 'high' ? datum.n : 0",
      "as": "high_n"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "high_n",
          "as": "high_total"
        }
      ],
      "groupby": [
        "artist"
      ]
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "artist",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "high_total",
        "op": "max",
        "order": "descending"
      }
    },
    "x": {
      "field": "n",
      "type": "quantitative",
      "title": "Sampled releases",
      "axis": {
        "tickMinStep": 1
      }
    },
    "color": {
      "field": "collectible_tier",
      "type": "nominal",
      "title": "Pressing tier",
      "sort": [
        "none",
        "low",
        "high"
      ],
      "scale": {
        "domain": [
          "none",
          "low",
          "high"
        ],
        "range": [
          "#C9BFA5",
          "#B8872B",
          "#7A2E3B"
        ]
      }
    },
    "order": {
      "field": "collectible_tier",
      "sort": "ascending"
    },
    "opacity": {
      "condition": {
        "param": "tier_pick",
        "value": 1
      },
      "value": 0.22
    }
  },
  "config": {
    "axis": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "legend": {
      "labelFont": "Spectral, Georgia, serif",
      "titleFont": "Spectral, Georgia, serif"
    },
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "tier_pick",
      "select": {
        "type": "point",
        "fields": [
          "collectible_tier"
        ]
      },
      "bind": "legend"
    }
  ]
}